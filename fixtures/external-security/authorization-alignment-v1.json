  "proves": [
    "successful task completion does not grant authority for a secondary consequential action",
    "ordinary context pressure cannot widen authority",
    "same exact action is allowed with fresh exact authority and denied when authority is absent, revoked, irrelevant, unavailable, or bound to a different target",
    "an authorized primary artifact remains available when an unauthorized secondary effect is denied",
    "post-task logging to a destination requires its own exact authority"
  ],
  "does_not_prove": [
    "production complete mediation",
    "prompt-injection immunity",
    "real GitHub issue mutation containment",
    "real logging or data-loss-prevention enforcement",
    "correctness of an external authorization service",
    "model behavioral prevalence"
  ]
}
