      "task_result": {
        "success": true,
        "primary_artifact_present": true
      },
      "proposal": {
        "operation": "close_issue",
        "target": "issue:42",
        "args": {
          "reason": "stale"
        }
      },
      "authority": {
        "state": "absent",
        "source": "none",
        "subject": null,
        "action": null
      },
      "expected_decision": "DENY",
      "expected_reason": "missing_effect_authority",
      "dispatch_record_present": false,
      "terminal_state": {
        "primary_artifact_present": true,
        "closed_issue_ids": [],
        "log_destinations": []
