  "proves": [
    "Synthetic label sequences preserve the AgentDrift published full, partial, delayed, resisted, benign and hard-negative grammars.",
    "A hijacked agent-selected tool action can be denied at the independently authorized effect boundary without a terminal protected mutation.",
    "A detector false negative cannot create independent authority, and detector suspicion does not itself deny an allowed benign effect.",
    "Allowed request and recorded effect remain separate; benign report can be allowed but not yet observed.",
    "The AgentDrift behavioral success label can remain true while a counterfactual independent host denies the protected mutation; both evaluation axes are modeled separately."
  ],
  "does_not_prove": [
    "A model followed the malicious content or that these manually authored steps were produced by AgentDrift upstream models.",
    "Any accuracy, recall or generalization for a real prompt-injection detector.",
    "Host isolation, production effect mediation, verification of claimed trace observations, or complete enumeration of bypass paths.",
    "Long-horizon, multi-agent, or memory-mediated attack resistance.",
    "That the original upstream hijacked tool calls were denied by an actual host; this governance overlay is an invented counterfactual to assess the effect boundary."
  ]
}
