  "proves": [
    "a disjunctive multi-parent batch cut cannot be computed by unioning independent single-edge cuts",
    "one surviving independent path preserves eligible delegation under the synthetic policy",
    "present reachability alone cannot determine future revocation of duplicate independent grants",
    "stale, forged, incomplete, or unavailable authority evidence cannot permit modeled dispatch",
    "a modeled denied or indeterminate request is not dispatch-eligible"
  ],
  "does_not_prove": [
    "Anthesis currently supports or should adopt multi-parent transitive delegation in v1",
    "revocation propagation to workers or physical protection of any downstream effect",
    "the authenticity or completeness of a real signer, roster, audit log, or effect observer",
    "authorization under conjunctive or threshold delegation policies",
    "a production authorization engine, Testule implementation, or cryptographic proof"
  ]
}
