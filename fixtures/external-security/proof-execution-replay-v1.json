  "proves": [
    "history integrity is different from capture completeness, replay fidelity and fresh authority in bounded synthetic cases",
    "a denied action with an independently observed effect cannot qualify as compliant",
    "a valid historical proof cannot authorize a later protected effect without fresh exact authorization"
  ],
  "does_not_prove": [
    "production complete mediation or sealed evidence authenticity",
    "real runtime collector timing or effect absence outside observed scope",
    "reproducibility of a changed external world",
    "current authorization, provider idempotency or recovery safety",
    "conformance, certification or remote policy semantics"
  ]
