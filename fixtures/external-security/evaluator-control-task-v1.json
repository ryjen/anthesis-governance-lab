    "missing or noncomparable controls remain unresolved rather than passing",
    "native proof of a weaker predicate cannot satisfy the declared stronger requirement"
  ],
  "does_not_prove": [
    "production governance control effectiveness or model generalization",
    "authenticity or independence of externally submitted labels and predictions",
    "permission to authorize effects or promote evaluator output",
    "statistical or causal proof outside the declared synthetic matched population"
  ]
