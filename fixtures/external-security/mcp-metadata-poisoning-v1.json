  "proves": [
    "synthetic MCP/tool metadata and server-provided text remain non-authoritative inputs",
    "effective host-resolved tool identity and arguments are checked against independent exact authority",
    "one tool or server cannot confer authority for another tool",
    "remote-skill permission widening and cross-origin use require explicit modeled approval",
    "denied consequential calls have no modeled protected effect",
    "source and field localization can be preserved without becoming authority"
  ],
  "does_not_prove": [
    "prompt-injection immunity in a production MCP client",
    "MCP protocol conformance or certification",
    "real server binary integrity or credential isolation",
    "complete mediation in a physical deployment",
    "universal attack detection or prevention rates",
    "cryptographic provenance or attestation"
  ]
}
