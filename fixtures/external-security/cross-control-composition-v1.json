  "proves": [
    "locally passing controls do not establish end-to-end security when required provenance, delegation, state, action, effect-path, or recovery assumptions are lost between stages",
    "positive composition preserves exact source provenance, delegated actor context, current state and effect-time authority across the same workflow shape",
    "a delayed state/policy change invalidates stale authorization even when earlier controls passed",
    "detection without quarantine, path closure and authority re-evaluation is not sufficient recovery",
    "recovery may close contaminated state/effect paths and continue independently authorized benign work",
    "an action transformation may preserve authorization only when the declared before/after relation is independently evidenced",
    "high utility, lower latency, or lower cost cannot compensate for a failed mandatory security gate",
    "a veto-capable deny has no protected effect in the synthetic boundary"
  ],
  "does_not_prove": [
    "one universal agent-security stack is secure",
    "the surveyed literature proves these exact controls sufficient in production",
    "a production model, retriever, runtime, gateway, memory system, or sandbox enforces the fixture",
    "all equivalent effect paths are mediated in production",
    "all malicious semantic transformations are detected",
    "certification or compliance"
  ]
}
